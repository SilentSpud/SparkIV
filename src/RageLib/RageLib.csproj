<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RageLib</Title>
    <Description>Library for handling Rockstar Advanced Game Engine (RAGE) files</Description>
    <Authors>aru;Ahmed Walid</Authors>
    <Company>Ahmed Walid</Company>
    <Copyright>Copyright (C) 2008 Arushan/Aru &lt;oneforaru at gmail.com&gt;</Copyright>
    <Product>RageLib</Product>
    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>

    <PackageId>RageLib</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ahmed605/SparkIV</PackageProjectUrl>
    <PackageReleaseNotes>v0.7.0 - Parallelism and broader framework support</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <SelfContained>false</SelfContained>
    <Platform>AnyCPU</Platform>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IncludeContentInPack>true</IncludeContentInPack>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Ookii.Dialogs.WinForms" Version="4.0.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Audio\AudioView.cs" SubType="UserControl" />
    <Compile Update="Models\ModelView.cs" SubType="UserControl" />
    <Compile Update="Textures\TextureEditView.cs" SubType="UserControl" />
    <Compile Update="Textures\TexturePreviewView.cs" SubType="UserControl" />
    <Compile Update="Textures\TextureView.cs" SubType="UserControl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Audio\SoundBank\Hashes\Names.txt" />
    <EmbeddedResource Include="Scripting\Script\NativesList.txt" />
    <Content Include="lib\ragezip.dll" Link="ragezip.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>